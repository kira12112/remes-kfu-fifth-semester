{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quiz",
  "type": "object",
  "required": ["id", "subjectId", "titleEn", "questions"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "subjectId": { "type": "string" },
    "lectureId": { "type": "string" },
    "titleEn": { "type": "string" },
    "titleAr": { "type": "string" },
    "description": { "type": "string" },
    "estimatedMinutes": { "type": "integer", "minimum": 1 },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "subjectId", "textEn", "options", "correctOptionId", "explanationEn", "difficulty"],
        "properties": {
          "id": { "type": "string" },
          "subjectId": { "type": "string" },
          "lectureId": { "type": "string" },
          "textEn": { "type": "string" },
          "textAr": { "type": "string" },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["id", "textEn"],
              "properties": {
                "id": { "type": "string" },
                "textEn": { "type": "string" },
                "textAr": { "type": "string" }
              }
            }
          },
          "correctOptionId": { "type": "string" },
          "explanationEn": { "type": "string" },
          "explanationAr": { "type": "string" },
          "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
